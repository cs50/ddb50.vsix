{
    "name": "ddb50",
    "displayName": "CS50 Duck",
    "description": "Provide everyone with their own virtual duck in VS Code. Introduce students to rubber duck debugging, a technique that involves talking to a rubber duck (or any inanimate, or even animate object) about a bug in their code. Now, with the power of OpenAI's ChatGPT, your rubber duck can talk back!",
    "icon": "images/ddb50.png",
    "version": "2.0.0",
    "publisher": "CS50",
    "repository": "https://github.com/cs50/ddb50.vsix",
    "engines": {
        "vscode": "^1.132.0"
    },
    "categories": [
        "Education"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "ddb50.downloadChatHistory",
                "title": "Download Chat History",
                "icon": "$(cloud-download)"
            },
            {
                "command": "ddb50.resetHistory",
                "title": "Clear Messages",
                "icon": "$(extensions-refresh)"
            }
        ],
        "configuration": [
            {
                "title": "Config Override",
                "properties": {
                    "ddb50.config": {
                        "type": "string",
                        "description": "Override default prompts configuration."
                    }
                }
            }
        ],
        "views": {
            "ddb50": [
                {
                    "id": "ddb50.chatWindow",
                    "name": "CS50 Duck Debugger",
                    "type": "webview"
                }
            ]
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "ddb50",
                    "title": "CS50 Duck Debugger",
                    "icon": "resources/ddb.svg"
                }
            ]
        },
        "menus": {
            "view/title": [
                {
                    "command": "ddb50.downloadChatHistory",
                    "group": "navigation",
                    "when": "view == ddb50.chatWindow"
                },
                {
                    "command": "ddb50.resetHistory",
                    "group": "navigation",
                    "when": "view == ddb50.chatWindow"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src",
        "test": "node ./out/test/runTest.js"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "^26.2.0",
        "@types/vscode": "^1.132.0",
        "@vscode/test-electron": "^3.1.0",
        "eslint": "^10.8.1",
        "glob": "^13.0.6",
        "mocha": "^11.8.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.67.0"
    },
    "dependencies": {
        "axios": "^1.19.0",
        "markdown-it": "^15.0.0",
        "markdown-it-highlightjs": "^4.3.0",
        "minimatch": "10.2.6",
        "uuid": "^14.0.2"
    },
    "overrides": {
        "mocha": {
            "diff": "^8.0.3",
            "serialize-javascript": "^7.0.5"
        }
    }
}
